#!/usr/bin/env sh
# Husky.Net pre-commit hook. Enable hooks once per clone with:
#   dotnet tool restore && dotnet husky install
# (sets core.hooksPath to .husky; .husky/_ is generated and ignored).
[ -f "$(dirname "$0")/_/husky.sh" ] && . "$(dirname "$0")/_/husky.sh"
set -e

dotnet test tests/LS.Tests.Architecture/LS.Tests.Architecture.csproj --filter FullyQualifiedName~MigrationGuardrailTests
