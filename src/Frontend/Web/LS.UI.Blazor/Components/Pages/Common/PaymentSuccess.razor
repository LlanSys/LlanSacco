@page "/payments/success"

<PageTitle>Payment Successful | LlanSacco</PageTitle>

<section class="dashboard-page">
    <MudPaper Class="poc-panel" Elevation="0">
        <span class="eyebrow">Payments</span>
        <h1>Payment submitted.</h1>
        <p>Stripe has accepted the checkout result. The backend webhook is responsible for final payment confirmation.</p>
        <MudButton Href="/dashboard" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Class="px-0 mb-3">Back To Dashboard</MudButton>
    </MudPaper>
</section>



