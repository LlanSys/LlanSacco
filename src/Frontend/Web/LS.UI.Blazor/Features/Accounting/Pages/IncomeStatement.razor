@page "/accounting/income-statement"
@using LS.SharedKernel.Features.Accounting.Dtos
@using LS.UI.Blazor.Features.Accounting.Contracts.Interfaces
@inject IFinanceService FinanceService
@inject ISnackbar Snackbar
@attribute [Authorize]

<PageTitle>Income Statement</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Income Statement</MudText>

<MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/accounting" Class="mb-4">Back to Accounting</MudButton>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="3">
            <MudDatePicker Margin="Margin.Dense" Variant="Variant.Outlined" Label="Start Date" @bind-Date="StartDate" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudDatePicker Margin="Margin.Dense" Variant="Variant.Outlined" Label="End Date" @bind-Date="EndDate" />
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-end">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadReport" Disabled="IsLoading">
                @if (IsLoading)
                {
                    <MudProgressCircular Class="ms-n1" Indeterminate="true"/>
                    <MudText Class="ms-2">Loading</MudText>
                }
                else
                {
                    <MudText>Generate Report</MudText>
                }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (ReportData != null)
{
    <MudTable Items="ReportData.Incomes.Concat(ReportData.Expenses)" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@IsLoading" Dense="true" Elevation="1">
        <HeaderContent>
            <MudTh>Account Code</MudTh>
            <MudTh>Account Name</MudTh>
            <MudTh>Type</MudTh>
            <MudTh Style="text-align:right">Balance</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Account Code">@context.AccountCode</MudTd>
            <MudTd DataLabel="Account Name">@context.AccountName</MudTd>
            <MudTd DataLabel="Type">
                @(ReportData.Incomes.Contains(context) ? "Revenue" : "Expense")
            </MudTd>
            <MudTd DataLabel="Balance" Style="text-align:right">@context.Balance.ToString("N2")</MudTd>
        </RowTemplate>
        <FooterContent>
            <MudTFootRow>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd><strong>Total Revenue</strong></MudTd>
                <MudTd Style="text-align:right"><strong>@ReportData.TotalIncome.ToString("N2")</strong></MudTd>
            </MudTFootRow>
            <MudTFootRow>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd><strong>Total Expense</strong></MudTd>
                <MudTd Style="text-align:right"><strong>@ReportData.TotalExpense.ToString("N2")</strong></MudTd>
            </MudTFootRow>
            <MudTFootRow>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd><strong>Net Surplus</strong></MudTd>
                <MudTd Style="text-align:right">
                    <strong style="color: @(ReportData.NetSurplus >= 0 ? "green" : "red")">
                        @ReportData.NetSurplus.ToString("N2")
                    </strong>
                </MudTd>
            </MudTFootRow>
        </FooterContent>
    </MudTable>
}

@code {
    private DateTime? StartDate { get; set; } = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime? EndDate { get; set; } = DateTime.Today;
    private bool IsLoading { get; set; }
    private IncomeStatementDto? ReportData;

    protected override async Task OnInitializedAsync()
    {
        await LoadReport();
    }

    private async Task LoadReport()
    {
        IsLoading = true;
        try
        {
            var startOffset = StartDate.HasValue ? new DateTimeOffset(DateTime.SpecifyKind(StartDate.Value, DateTimeKind.Utc)) : (DateTimeOffset?)null;
            var endOffset = EndDate.HasValue ? new DateTimeOffset(DateTime.SpecifyKind(EndDate.Value, DateTimeKind.Utc)) : (DateTimeOffset?)null;
                
            var response = await FinanceService.GetIncomeStatementAsync(startOffset, endOffset);
            if (response.IsSuccess && response.Data != null)
            {
                ReportData = response.Data;
            }
            else
            {
                Snackbar.Add(response.Error?.Message ?? "Failed to load income statement", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }
}





