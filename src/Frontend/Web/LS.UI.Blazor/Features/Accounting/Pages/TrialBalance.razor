@page "/accounting/trial-balance"
@using LS.SharedKernel.Features.Accounting.Dtos
@using LS.UI.Blazor.Features.Accounting.Contracts.Interfaces
@inject IFinanceService FinanceService
@inject ISnackbar Snackbar
@attribute [Authorize]

<PageTitle>Trial Balance</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Trial Balance</MudText>

<MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/accounting" Class="mb-4">Back to Accounting</MudButton>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" Label="As Of Date" @bind-Date="AsOfDate" />
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-end">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadReport" Disabled="IsLoading">
                @if (IsLoading)
                {
                    <MudProgressCircular Class="ms-n1" Indeterminate="true"/>
                    <MudText Class="ms-2">Loading</MudText>
                }
                else
                {
                    <MudText>Generate Report</MudText>
                }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (ReportData != null)
{
    <MudTable Items="ReportData.Rows" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@IsLoading" Dense="true" Elevation="1">
        <HeaderContent>
            <MudTh>Account Code</MudTh>
            <MudTh>Account Name</MudTh>
            <MudTh Style="text-align:right">Debit</MudTh>
            <MudTh Style="text-align:right">Credit</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Account Code">@context.AccountCode</MudTd>
            <MudTd DataLabel="Account Name">@context.AccountName</MudTd>
            <MudTd DataLabel="Debit" Style="text-align:right">@context.Debit.ToString("N2")</MudTd>
            <MudTd DataLabel="Credit" Style="text-align:right">@context.Credit.ToString("N2")</MudTd>
        </RowTemplate>
        <FooterContent>
            <MudTFootRow>
                <MudTd></MudTd>
                <MudTd><strong>Total</strong></MudTd>
                <MudTd Style="text-align:right"><strong>@ReportData.TotalDebit.ToString("N2")</strong></MudTd>
                <MudTd Style="text-align:right"><strong>@ReportData.TotalCredit.ToString("N2")</strong></MudTd>
            </MudTFootRow>
        </FooterContent>
    </MudTable>
}

@code {
    private DateTime? AsOfDate { get; set; } = DateTime.Today;
    private bool IsLoading { get; set; }
    private TrialBalanceResponse? ReportData;

    protected override async Task OnInitializedAsync()
    {
        await LoadReport();
    }

    private async Task LoadReport()
    {
        IsLoading = true;
        try
        {
            var offset = AsOfDate.HasValue 
                ? new DateTimeOffset(DateTime.SpecifyKind(AsOfDate.Value, DateTimeKind.Utc)) 
                : DateTimeOffset.UtcNow;
                
            var response = await FinanceService.GetTrialBalanceAsync(offset);
            if (response.IsSuccess && response.Data != null)
            {
                ReportData = response.Data;
            }
            else
            {
                Snackbar.Add(response.Error?.Message ?? "Failed to load trial balance", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }
}






