@using LS.SharedKernel.Features.Banking.Savings.Dtos
@using LS.UI.Blazor.Features.Banking.Contracts.Interfaces
@using LS.UI.Blazor.Features.Banking.Components
@inject ISavingsService SavingsService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="d-flex justify-space-between mb-4 mt-2">
    <MudText Typo="Typo.subtitle1">Savings Accounts</MudText>
    <div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenDepositDialog" Class="mr-2">
            Deposit
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Remove" OnClick="OpenWithdrawDialog">
            Withdraw
        </MudButton>
    </div>
</div>

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudTable Items="@_accounts" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Dense="true" Class="mb-4">
        <HeaderContent>
            <MudTh>Product</MudTh>
            <MudTh>Balance</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Opened At</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Product">@context.ProductName</MudTd>
            <MudTd DataLabel="Balance">@context.Balance.ToString("N2")</MudTd>
            <MudTd DataLabel="Status">
                @if (context.IsActive)
                {
                    <MudChip Variant="Variant.Outlined" T="string" Color="Color.Success" Size="Size.Small">Active</MudChip>
                }
                else
                {
                    <MudChip Variant="Variant.Outlined" T="string" Color="Color.Error" Size="Size.Small">Inactive</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Opened At">@context.OpenedAt.ToString("g")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter] public Guid MemberId { get; set; }

    private bool _isLoading = true;
    private List<SavingsAccountResponse> _accounts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        _isLoading = true;
        StateHasChanged();
        
        var result = await SavingsService.GetMemberSavingsAccountsAsync(MemberId);
        if (result.IsSuccess && result.Data != null)
        {
            _accounts = result.Data.ToList();
        }
        else
        {
            Snackbar.Add(result.Error?.Message ?? "Failed to load savings accounts", Severity.Error);
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task OpenDepositDialog()
    {
        var parameters = new DialogParameters { { "MemberId", MemberId }, { "Accounts", _accounts } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<DepositSavingsDialog>("Deposit Savings", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadAccountsAsync();
        }
    }

    private async Task OpenWithdrawDialog()
    {
        var parameters = new DialogParameters { { "MemberId", MemberId }, { "Accounts", _accounts } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<WithdrawSavingsDialog>("Withdraw Savings", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadAccountsAsync();
        }
    }
}
