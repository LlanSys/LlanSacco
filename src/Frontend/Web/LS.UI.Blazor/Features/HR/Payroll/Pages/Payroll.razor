@page "/hr/payroll"
@using LS.UI.Rcl.Features.HR.Payroll.Contracts.Interfaces
@using LS.SharedKernel.Features.HR.Payroll.Dtos
@using CurrieTechnologies.Razor.SweetAlert2
@inject IPayrollService PayrollService
@inject ISnackbar Snackbar
@inject SweetAlertService Swal

<PageTitle>Payroll Engine | LlanSacco</PageTitle>

<RequireAuthenticated>
    <section class="dashboard-page">
        <div class="dashboard-hero compact-hero">
            <div>
                <span class="eyebrow">HR & Payroll</span>
                <h1 style="font-size: 1.5rem;">Payroll Management</h1>
                <p style="font-size: 0.85rem;">Run current period payroll, close active periods, and view historical runs.</p>
            </div>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/hr/payroll/settings"
                           StartIcon="@Icons.Material.Filled.Settings">
                    Configuration
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunPayrollAsync"
                           StartIcon="@Icons.Material.Filled.PlayArrow">
                    Run Payroll
                </MudButton>
            </div>
        </div>

        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" />
        }
        else
        {
            <MudPaper Elevation="0" Outlined="true" Class="mt-4 pa-4">
                <div class="d-flex justify-space-between align-center mb-4">
                    <MudText Typo="Typo.h6" Style="font-size: 1rem; font-weight: 600;">Payroll Periods</MudText>
                    
                    <div class="d-flex gap-2">
                        <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_filterYear" Label="Year" Style="width: 100px;" />
                        <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_filterMonth" Label="Month" Style="width: 100px;" />
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LoadPeriodsAsync">Filter</MudButton>
                    </div>
                </div>

                <MudTable Items="@_periods" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Period</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Processed At</MudTh>
                        <MudTh>Processed By</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Period">@($"{context.Month:D2}/{context.Year}")</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Color="@(context.Status == "Closed" ? Color.Success : Color.Warning)">
                                @context.Status
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Processed At">@(context.ProcessedAt?.ToString("g") ?? "-")</MudTd>
                        <MudTd DataLabel="Processed By">@(context.ProcessedBy ?? "-")</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/hr/payroll/{context.Id}")">View Payslips</MudButton>
                            @if (context.Status == "Open")
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => ClosePeriodAsync(context))">Close Period</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2">No payroll periods found.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        }
    </section>
</RequireAuthenticated>

@code {
    private bool _isLoading = true;
    private List<PayrollPeriodResponse> _periods = new();
    private int _filterYear = DateTime.Now.Year;
    private int _filterMonth = DateTime.Now.Month;

    protected override async Task OnInitializedAsync()
    {
        await LoadPeriodsAsync();
    }

    private async Task LoadPeriodsAsync()
    {
        _isLoading = true;
        // In this implementation, if Year/Month is 0 it could return all. We are passing the filter.
        // Actually our backend GetPayrollPeriodsQuery doesn't filter perfectly yet, but let's pass them.
        var query = new GetPayrollPeriodsRequest(_filterYear, _filterMonth);
        var response = await PayrollService.GetPayrollPeriodsAsync(query);
        
        if (response.IsSuccess && response.Data != null)
        {
            _periods = response.Data.ToList();
        }
        else
        {
            Snackbar.Add(response.Message ?? "Failed to load payroll periods.", Severity.Error);
        }
        
        _isLoading = false;
    }

    private async Task RunPayrollAsync()
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Run Payroll?",
            Text = $"This will execute payroll calculations for the current period ({DateTime.Now.Month:D2}/{DateTime.Now.Year}). Ensure all configurations and employee settings are correct before proceeding.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Execute Payroll",
            CancelButtonText = "Cancel",
            ConfirmButtonColor = "var(--mud-palette-primary)",
            CancelButtonColor = "var(--mud-palette-surface)"
        });

        if (!string.IsNullOrEmpty(result.Value))
        {
            _isLoading = true;
            // The backend automatically picks up the current active or next open period if we pass an empty Guid 
            // depending on implementation, but let's assume the backend handles it via the RunPayrollCommand logic.
            // Wait, looking at RunPayrollCommand, it takes PayrollPeriodId. We should probably create one if it doesn't exist.
            var command = new RunPayrollRequest(Guid.Empty, "System"); // Backend needs to handle Guid.Empty or we pass a selected one.

            var response = await PayrollService.RunPayrollAsync(command);
            if (response.IsSuccess)
            {
                await Swal.FireAsync("Success", "Payroll run completed successfully.", SweetAlertIcon.Success);
                await LoadPeriodsAsync();
            }
            else
            {
                await Swal.FireAsync("Error", response.Message ?? "An error occurred during payroll execution.", SweetAlertIcon.Error);
            }
            _isLoading = false;
        }
    }

    private async Task ClosePeriodAsync(PayrollPeriodResponse period)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Close Period?",
            Text = $"Are you sure you want to close the period {period.Month:D2}/{period.Year}? This action cannot be reversed.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Close Period",
            CancelButtonText = "Cancel",
            ConfirmButtonColor = "var(--mud-palette-error)",
            CancelButtonColor = "var(--mud-palette-surface)"
        });

        if (!string.IsNullOrEmpty(result.Value))
        {
            _isLoading = true;
            var command = new ClosePayrollPeriodRequest(period.Id, "Admin");
            var response = await PayrollService.ClosePayrollPeriodAsync(command);
            
            if (response.IsSuccess)
            {
                Snackbar.Add("Period closed successfully.", Severity.Success);
                await LoadPeriodsAsync();
            }
            else
            {
                Snackbar.Add(response.Message ?? "Failed to close period.", Severity.Error);
            }
            _isLoading = false;
        }
    }
}








