@page "/iam/reset-password"
@layout AuthLayout
@rendermode InteractiveServer
@inject IAuthService AuthService
@inject LS.UI.Blazor.Features.IAM.Users.State.PasswordRecoveryState RecoveryState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Reset password | LlanSacco</PageTitle>

<div class="auth-header">
    <h1>Choose a new password</h1>
    <p>Use a strong password you have not used for this account before.</p>
</div>

<div class="auth-card">
        @if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            <div class="form-stack">
                <div class="alert alert-danger" role="alert">This password-reset request is invalid. Start a new recovery request.</div>
                <a class="btn btn-bt-primary btn-lg" href="/iam/forgot-password">Start recovery</a>
            </div>
        }
        else if (_linkState == LinkState.Checking)
        {
            <div class="form-stack" role="status" aria-live="polite">
                <p>Checking your password link...</p>
            </div>
        }
        else if (_linkState == LinkState.Unusable)
        {
            <div class="form-stack">
                <div class="alert alert-danger" role="alert">@_linkMessage</div>
                <a class="btn btn-bt-primary btn-lg" href="/iam/forgot-password">Request a new link</a>
                <a class="auth-recovery-link" href="/iam/sign-in">Back to sign in</a>
            </div>
        }
        else
        {
            <EditForm FormName="iam-reset-password" Model="_formModel" OnValidSubmit="ResetAsync">
                <DataAnnotationsValidator />
                <div class="form-stack">
                    <div>
                        <label for="new-password">New password</label>
                        <InputText id="new-password" type="password" class="form-control form-control-lg" @bind-Value="_formModel.NewPassword" autocomplete="new-password" />
                        <ValidationMessage For="@(() => _formModel.NewPassword)" />
                    </div>
                    <div>
                        <label for="confirm-password">Confirm password</label>
                        <InputText id="confirm-password" type="password" class="form-control form-control-lg" @bind-Value="_formModel.ConfirmPassword" autocomplete="new-password" />
                        <ValidationMessage For="@(() => _formModel.ConfirmPassword)" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_message))
                    {
                        <div class="alert alert-danger" role="alert">@_message</div>
                    }

                    <button class="btn btn-bt-primary btn-lg" type="submit" disabled="@_isBusy">
                        @(_isBusy ? "Updating..." : "Update password")
                    </button>
                </div>
            </EditForm>
        }
    </div>


@code {
    private readonly ResetPasswordFormModel _formModel = new();
    private const string UnusableLinkMessage =
        "This password link is no longer valid. It may have expired, already been used, or the account's access may have been revoked. Use \"Forgot password?\" to request a new one, or ask your administrator to resend access.";

    private enum LinkState { Checking, Usable, Unusable }

    private bool _isBusy;
    private string? _message;
    private LinkState _linkState = LinkState.Checking;
    private string _linkMessage = UnusableLinkMessage;

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    protected override void OnInitialized()
    {
        if ((string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token)) &&
            RecoveryState.TryConsume(out var email, out var transitionToken))
        {
            Email = email;
            Token = transitionToken;
        }
    }

    // Check the link before asking for a password, so a revoked, used or expired link is refused up front.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            return;
        }

        var response = await AuthService
            .ValidatePasswordResetLinkAsync(new ValidatePasswordResetLinkRequest(Email.Trim(), Token))
            .ConfigureAwait(true);

        // Only the server's verdict that the link is unusable blocks the form. Outages and throttling fall through
        // to the form, whose submit reports them, rather than wrongly calling a good link dead.
        if (!response.IsSuccess && response.Error?.Type == LS.SharedKernel.Features.Shared.Common.Enums.ErrorType.BusinessRule)
        {
            _linkState = LinkState.Unusable;
            _linkMessage = UserMessageSanitizer.Normalize(response.Error.Message, UnusableLinkMessage);
        }
        else
        {
            _linkState = LinkState.Usable;
        }

        StateHasChanged();
    }

    private async Task ResetAsync()
    {
        _isBusy = true;
        _message = null;

        var request = new ResetPasswordRequest(
            Email!.Trim(),
            _formModel.NewPassword,
            null,
            _formModel.ConfirmPassword,
            Token);
        var response = await AuthService.ResetPasswordAsync(request).ConfigureAwait(true);

        _isBusy = false;
        if (!response.IsSuccess || response.Data != true)
        {
            _message = UserMessageSanitizer.Normalize(response.Message, "Your password could not be reset. Request a new recovery code or link and try again.");
            return;
        }

        Snackbar.Add("Password updated. You can now sign in.", Severity.Success);
        Navigation.NavigateTo("/iam/sign-in");
    }
}



