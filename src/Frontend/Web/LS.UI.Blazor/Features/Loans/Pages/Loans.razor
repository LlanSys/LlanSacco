@page "/loans"
@using LS.SharedKernel.Features.Loans.Dtos
@using LS.UI.Blazor.Features.Loans.Contracts.Interfaces
@inject ILoanService LoanService
@inject ISnackbar Snackbar
@attribute [Authorize]

<PageTitle>Loans Dashboard | LlanSacco</PageTitle>

<div class="d-flex justify-space-between align-center mb-6">
    <div>
        <MudText Typo="Typo.h4" Class="fw-bold" Color="Color.Primary">Loans Dashboard</MudText>
        <MudText Typo="Typo.body2" Color="Color.Surface">Overview of loan portfolio and applications.</MudText>
    </div>
    <div>
        <MudButton Variant="Variant.Outlined" Href="/loans/applications" Color="Color.Primary" StartIcon="@Icons.Material.Filled.List" Class="me-2">
            View Applications
        </MudButton>
        <MudButton Variant="Variant.Filled" Href="/loans/products" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Category">
            Manage Products
        </MudButton>
    </div>
</div>

@if (IsLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (Stats == null)
{
    <MudAlert Severity="Severity.Error">Failed to load dashboard statistics.</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-theme-primary" Elevation="2" Style="border-radius: 12px; min-height: 140px;">
                <MudIcon Icon="@Icons.Material.Filled.MonetizationOn" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.h4" Class="fw-bold">@Stats.TotalActiveLoans</MudText>
                <MudText Typo="Typo.body1">Active Loans</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-theme-warning" Elevation="2" Style="border-radius: 12px; min-height: 140px; cursor: pointer;" @onclick="@(() => Navigation.NavigateTo("/loans/applications"))">
                <MudIcon Icon="@Icons.Material.Filled.PendingActions" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.h4" Class="fw-bold">@Stats.PendingApplications</MudText>
                <MudText Typo="Typo.body1">Pending Applications</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-theme-error" Elevation="2" Style="border-radius: 12px; min-height: 140px;">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.h4" Class="fw-bold">@Stats.LoansInArrears</MudText>
                <MudText Typo="Typo.body1">Loans in Arrears</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-theme-info" Elevation="2" Style="border-radius: 12px; min-height: 140px;">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.h4" Class="fw-bold">@Stats.TotalDisbursedAmount.ToString("C")</MudText>
                <MudText Typo="Typo.body1">Total Disbursed</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
    
    <MudGrid Class="mt-4">
        <MudItem xs="12">
            <MudCard Elevation="2" Style="border-radius: 12px;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Quick Actions</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <div class="d-flex flex-wrap gap-4">
                        <MudButton Variant="Variant.Outlined" Href="/loans/applications" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Assignment">
                            Review Applications
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Href="/loans/products" Color="Color.Info" StartIcon="@Icons.Material.Filled.Category">
                            Configure Products
                        </MudButton>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private LoanDashboardStatsResponse? Stats { get; set; }
    private bool IsLoading { get; set; } = true;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
    }

    private async Task LoadStats()
    {
        IsLoading = true;
        try
        {
            var response = await LoanService.GetDashboardStatsAsync();
            if (response.IsSuccess && response.Data != null)
            {
                Stats = response.Data;
            }
            else
            {
                Snackbar.Add(response.Error?.Message ?? "Failed to load dashboard statistics.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading dashboard statistics: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }
}
