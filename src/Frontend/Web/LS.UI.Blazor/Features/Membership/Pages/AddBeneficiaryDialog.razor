@using LS.SharedKernel.Features.Membership.Dtos
@using LS.UI.Blazor.Features.Membership.Contracts.Interfaces
@inject IMembershipService MembershipService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <EditForm Model="@_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.FirstName" Label="First Name" Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.LastName" Label="Last Name" Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.Relationship" Label="Relationship (e.g. Spouse, Child)" Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.NationalId" Label="National ID / Birth Cert No" Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.PhoneNumber" Label="Phone Number" Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_model.AllocationPercentage" Label="Allocation %" Required="true" Min="1M" Max="100M" Adornment="Adornment.End" AdornmentText="%" />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_model.IsNextOfKin" Label="Is Next of Kin?" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@_isSubmitting">
            @(_isSubmitting ? "Adding..." : "Add Beneficiary")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public Guid MemberId { get; set; }

    private AddBeneficiaryModel _model = new();
    private bool _isSubmitting;

    public class AddBeneficiaryModel
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Relationship { get; set; } = "";
        public string PhoneNumber { get; set; } = "";
        public string NationalId { get; set; } = "";
        public decimal AllocationPercentage { get; set; } = 100M;
        public bool IsNextOfKin { get; set; } = false;
    }

    private async Task Submit()
    {
        _isSubmitting = true;
        try
        {
            var request = new AddBeneficiaryRequest(
                _model.FirstName,
                _model.LastName,
                _model.Relationship,
                _model.PhoneNumber,
                "", // Email
                _model.NationalId,
                _model.AllocationPercentage,
                _model.IsNextOfKin
            );

            var response = await MembershipService.AddBeneficiaryAsync(MemberId, request);
            if (response.IsSuccess)
            {
                Snackbar.Add("Beneficiary added successfully.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response.Message ?? "Failed to add beneficiary.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
